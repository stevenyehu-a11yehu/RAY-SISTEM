# ==========================================
# KONFIGURASI DOCUMENT TRACKER VENDOR
# ==========================================

# Port server lokal (default: 3000)
PORT=3000
NODE_ENV=development

# JWT Secret untuk otentikasi login admin (wajib diganti dengan string acak yang kuat di production)
JWT_SECRET="ganti_dengan_jwt_secret_rahasia_dan_panjang_12345"

# Akun Admin Pertama (otomatis di-seed saat pertama kali dijalankan)
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="admin123"

# ==========================================
# GOOGLE CLOUD SERVICE ACCOUNT (DRIVE & SHEETS)
# ==========================================
# ID Spreadsheet Google Sheets yang digunakan sebagai database utama
# Ambil dari URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"

# ID Folder Google Drive tempat menyimpan berkas yang diunggah
# Ambil dari URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID="1_Vq7Y-1oWXYZ987654321abcdef"

# Kredensial Service Account JSON (bisa berupa teks JSON satu baris atau path file)
# Opsi 1 (Direkomendasikan untuk Cloud/VPS): Teks JSON lengkap
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"project-anda","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"sa-vendor-tracker@project-anda.iam.gserviceaccount.com","client_id":"..."}'

# Opsi 2 (Alternatif di lokal): Path ke file JSON yang diunduh dari Google Cloud Console
# GOGOOGLE_SERVICE_ACCOUNT_PATH="./service-account.json"

# ==========================================
# GATEWAY WHATSAPP VIA FONNTE
# ==========================================
# Token API Fonnte dari menu Perangkat di https://fonnte.com
FONNTE_TOKEN="abc123tokenfonnte"
FONNTE_API_URL="https://api.fonnte.com/send"

# Nomor WhatsApp default internal Anda (akan otomatis diformat ke 62xxx)
DEFAULT_WA_NUMBER="081234567890"

# ==========================================
# PENGATURAN UMUM
# ==========================================
# Batas ukuran upload berkas default dalam Megabytes (default: 10)
MAX_FILE_SIZE_MB=10

# Zona Waktu untuk scheduler pengingat (Asia/Jakarta, Asia/Makassar, Asia/Jayapura)
TIMEZONE="Asia/Jakarta"
